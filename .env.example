# Copy this file to `.env` and adjust values as needed.
# These environment variables are optional — the app runs with sane defaults.

# --- OpenTelemetry / APM ---
# When set, traces are exported via OTLP (e.g. to a Jaeger or OTel Collector endpoint)
# in addition to the always-on console exporter. Leave unset to use console only.
# Example for a local Jaeger all-in-one with OTLP enabled:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Logical service name reported in traces (defaults to "ai-task-risk-analyzer").
# OTEL_SERVICE_NAME=ai-task-risk-analyzer

# --- HTTP server (optional overrides) ---
# HOST=127.0.0.1
# PORT=8000
